# ============================================================================
# TyperLM26: Environment Variables Configuration
# ============================================================================

# 1. Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Modern Publishable Key (sb_publishable_...) or legacy Anon Key (eyJ...)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Server-Only Configuration (CRITICAL: NEVER expose to browser/client)
# Modern Secret Key (sb_secret_...) or legacy Service Role Key (eyJ...)
SUPABASE_SECRET_KEY=sb_secret_your-secret-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# 3. Application Public URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. Initial Admin Bootstrap Script Settings (Optional CLI bootstrap)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminStartowe2026!
BOOTSTRAP_ADMIN_FIRSTNAME=Administrator
BOOTSTRAP_ADMIN_LASTNAME=Główny
