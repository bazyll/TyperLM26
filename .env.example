# Supabase Public Configuration (Browser + Server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Only Configuration (NEVER expose to client/browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Initial Admin Bootstrap Script Settings
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminStartowe2026!
BOOTSTRAP_ADMIN_FIRSTNAME=Administrator
BOOTSTRAP_ADMIN_LASTNAME=Główny
